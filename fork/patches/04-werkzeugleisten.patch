+/// Hirch CAM (Peter 10.11.): ein Zeichen als Bild – die Umrisse aus Inkscapes eigener Schrift (FontInstance, wie auf
+/// der Zeichenfläche; unter Windows kennt die Standard-Schriftliste von Pango die mitgebrachten Schriften nicht,
+/// Windows 355999b), gefüllt; ist nichts gefüllt (Einlinienschrift: Linien ohne Fläche), die Linien nachgezogen.
+static Glib::RefPtr<Gdk::Pixbuf> hirch_zeichen_bild(std::shared_ptr<FontInstance> const &font, gunichar ch, int kante,
+                                                     Gdk::RGBA const &farbe)
+{
+    auto flaeche = Cairo::ImageSurface::create(Cairo::FORMAT_ARGB32, kante, kante);
+    auto cr = Cairo::Context::create(flaeche);
+    int const gid = font ? font->MapUnicodeChar(ch) : 0;
+    Geom::PathVector const *pv = gid > 0 ? font->PathVector(gid) : nullptr;
+    if (pv && !pv->empty()) {
+        auto box = pv->boundsExact();
+        if (box) {
+            double const em = kante * 0.6;                 // 1 em = 60 % der Zelle
+            double const m = std::max(box->width(), box->height()) * em;
+            double const s = m > kante * 0.86 ? em * kante * 0.86 / m : em;   // grosse Zeichen einpassen
+            Geom::Point mitte = box->midpoint();
+            // Umrisse der Schrift: y nach oben – fürs Bild spiegeln
+            Geom::Affine t = Geom::Translate(-mitte) * Geom::Scale(s, -s) * Geom::Translate(kante / 2.0, kante / 2.0);
+            Geom::PathVector p = *pv * t;
+            cr->set_source_rgba(farbe.get_red(), farbe.get_green(), farbe.get_blue(), farbe.get_alpha());
+            feed_pathvector_to_cairo(cr->cobj(), p);
+            cr->fill();
+            flaeche->flush();
+            bool leer = true;
+            unsigned char const *d = flaeche->get_data();
+            int const schritt = flaeche->get_stride();
+            for (int y = 0; y < kante && leer; ++y)
+                for (int x = 0; x < kante && leer; ++x)
+                    if (d[y * schritt + x * 4 + 3] != 0) leer = false;
+            if (leer) {
+                feed_pathvector_to_cairo(cr->cobj(), p);
+                cr->set_line_width(1.2);
+                cr->set_line_join(Cairo::LINE_JOIN_ROUND);
+                cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+                cr->stroke();
+            }
+        }
+    }
+    return Gdk::Pixbuf::create(flaeche, 0, 0, kante, kante);
+}
