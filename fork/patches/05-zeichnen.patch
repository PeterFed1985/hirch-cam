+/// Gravurtext zeigt bewusst die Rillenbreite: nicht verfeinern.
+static bool hirch_echte_breite(SPItem const *item)
+{
+    int n = 0;
+    for (auto o = static_cast<SPObject const *>(item); o && n < 5; o = o->parent, ++n) {
+        if (auto r = o->getRepr(); r && r->attribute("hirch:gravurtext")) return true;
+    }
+    return false;
+}
