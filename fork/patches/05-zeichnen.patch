+void Inkscape::SelTrans::hirchBezugSetzen(int spalte, int zeile)
+{
+    for (auto &k : knots) k->selectKnot(false);
+    if (spalte >= 0) {
+        double const y_dir = _desktop->yaxisdir();
+        double const zx = spalte / 2.0;
+        double const zy = y_dir > 0 ? zeile / 2.0 : 1.0 - zeile / 2.0;
+        if (spalte == 1 && zeile == 1) {
+            knots[0]->selectKnot(true);            // Mitte: der Drehpunkt-Anfasser
+        } else {
+            for (int i = 1; i < NUMHANDS; i++) {
+                if (hands[i].type != HANDLE_SCALE && hands[i].type != HANDLE_STRETCH) continue;
+                double bx = hands[i].x, by = (hands[i].y - 0.5) * (-y_dir) + 0.5;
+                if (std::fabs(bx - zx) < 1e-6 && std::fabs(by - zy) < 1e-6) {
+                    knots[i]->selectKnot(true);
+                    break;
+                }
+            }
+        }
+    }
+    _updateHandles();
+}
