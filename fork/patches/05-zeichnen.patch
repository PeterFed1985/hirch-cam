+void Inkscape::DocumentUndo::anhaengen(SPDocument *doc)
+{
+    if (!doc || !doc->sensitive) return;
+    doc->collectOrphans();
+    doc->ensureUpToDate();
+    Inkscape::XML::Event *log = sp_repr_coalesce_log(doc->partial, sp_repr_commit_undoable(doc->rdoc));
+    doc->partial = nullptr;
+    if (log) {
+        if (!doc->undo.empty() && doc->redo.empty()) {
+            doc->undo.back()->event = sp_repr_coalesce_log(doc->undo.back()->event, log);
+        } else {
+            sp_repr_free_log(log);
+        }
+        doc->virgin = FALSE;
+        doc->setModifiedSinceSave();
+    }
+    sp_repr_begin_transaction(doc->rdoc);
+}
