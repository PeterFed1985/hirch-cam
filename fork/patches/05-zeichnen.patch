+void hirch_verfeinern(DrawingContext &dc, Drawing &drawing, SPItem const *item, double breite)
+{
+    if (hirch_linien_max <= 0 || !drawing.getCanvasItemDrawing()) return;   // nur Arbeitsfläche, kein Export
+    double dx = 1.0, dy = 0.0;
+    dc.device_to_user_distance(dx, dy);
+    double grenze = std::hypot(dx, dy) * hirch_linien_max;
+    if (breite > grenze && !hirch_echte_breite(item)) dc.setLineWidth(grenze);
+}
