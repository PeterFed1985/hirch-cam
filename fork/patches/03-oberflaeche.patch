+void CanvasGrid::hirch_3d(Gtk::Widget *w, bool an)
+{
+    if (w && w != _hirch_3d) {
+        if (_hirch_3d) static_cast<Gtk::Container &>(_canvas_overlay).remove(*_hirch_3d);
+        _hirch_3d = w;
+        _canvas_overlay.add_overlay(*w);
+        // die schwebende Leiste bleibt darüber: sie trägt den Umschalter 2D | 3D (Peter, 22.10.)
+        if (_hirch_leiste) _canvas_overlay.reorder_overlay(*_hirch_leiste, -1);
+        w->set_no_show_all(true);
+        w->hide();
+    }
+    if (!_hirch_3d || an == _hirch_3d_an) return;
+    _hirch_3d_an = an;
+    if (an) {
+        _hirch_lineale = _show_rulers;
+        _hirch_leisten = _show_scrollbars;
+        ShowRulers(false);
+        ShowScrollbars(false);
+        // die Leiste bleibt (Umschalter 2D | 3D); ihre Zeichenwerkzeuge blendet sie in 3D selbst aus
+        _canvas->set_visible(false);                       // nichts scheint durch, nichts rechnet umsonst
+        _hirch_3d->set_no_show_all(false);
+        _hirch_3d->show_all();
+        _hirch_3d->set_no_show_all(true);
+        _hirch_3d->grab_focus();
+    } else {
+        _hirch_3d->hide();
+        _canvas->set_visible(true);
+        ShowRulers(_hirch_lineale);
+        ShowScrollbars(_hirch_leisten);
+    }
+}
